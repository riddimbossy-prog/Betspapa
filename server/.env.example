NODE_ENV=development
PORT=4173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:4173,https://betspapa.com,https://www.betspapa.com

# Any one of these API-Football aliases may be used. API_FOOTBALL_KEY is preferred.
API_FOOTBALL_KEY=
FOOTBALL_API_KEY=
API_STATS_KEY=
ODDS_API_KEY=

# Athena v3 background event hydration limits. Lower values protect provider quota.
ATHENA_EVENT_HYDRATION_LIMIT=20
ATHENA_EVENT_HYDRATION_PER_TEAM=8
ATHENA_EVENT_RETRY_HOURS=24

# Long random value used only for protected /api/admin routes.
ADMIN_SYNC_SECRET=
